# metallomaster.by — конфигурация сервера
#
# Файл копируется в корень сборки (dist/.htaccess) вместе с остальным содержимым public/.
# Читается ТОЛЬКО Apache и LiteSpeed. nginx его не видит — и не сообщает об этом: правила
# просто не работают. Проверить сервер: curl -I https://metallomaster.by | grep -i server
#
# Хостинг domain.by: Apache 2.4 с .htaccess, но перед ним стоит nginx, и статику он отдаёт
# сам, минуя Apache. Значит правила ниже применяются к страницам, а к файлам из /_astro/
# могут не примениться — кэш для них настраивается в ispmanager (см. раздел DEPLOY в TODO.md).
#
# Что здесь настроено:
#   1. 301-редиректы со старых адресов (полная карта — этот файл, других копий нет)
#   2. http → https и www → без www
#   3. Своя страница 404
#   4. Заголовки безопасности
#   5. Кэширование
#   6. Сжатие brotli/gzip
#
# Проверка после деплоя:
#   curl -I https://metallomaster.by/kolpak-na-stolb.html   → 301 на /catalog/chimney-caps/post-cap/
#   curl -I http://metallomaster.by/                        → 301 на https://metallomaster.by/
#   curl -I https://metallomaster.by/                       → заголовки безопасности на месте
#   curl -I https://metallomaster.by/no-such-page/          → 404, не 200

Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 0. Служебные файлы и каталоги ---------------------------------------
  # Всё, что начинается с точки, наружу не отдаём: .env, .git, .htaccess.
  # Правило по ПУТИ, а не по имени файла: FilesMatch сверяется только с именем,
  # поэтому каталог .git он не закрывает — файлы внутри называются config, HEAD,
  # index, и по ним выкачивается вся история репозитория вместе с окружением.
  # Исключение для .well-known обязательно: по нему продлевается сертификат.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # --- 1. Старые адреса → новые (301) --------------------------------------
  # Этот блок — единственная карта 301: переименовали или удалили страницу — правило
  # добавляется сюда, иначе адрес выпадет из индекса. Цели указаны абсолютным https-адресом
  # намеренно: запрос по старому http-адресу отдаёт один 301 вместо цепочки из двух.
  # Порядок важен — этот блок идёт до нормализации схемы и хоста.

  # Служебные страницы
  RewriteRule ^index\.html$ https://metallomaster.by/ [R=301,L]
  RewriteRule ^katalog-produkcii\.html$ https://metallomaster.by/catalog/ [R=301,L]
  RewriteRule ^kontakty\.html$ https://metallomaster.by/contacts/ [R=301,L]
  RewriteRule ^zakazatj\.html$ https://metallomaster.by/order/ [R=301,L]
  # Страница «спасибо» старой формы: в карте сайта её не было, но живьём отдаёт 200
  RewriteRule ^zayavka\.html$ https://metallomaster.by/order/ [R=301,L]

  # Категории
  RewriteRule ^dimohodi-iz-nerzhaveyuschej-stali\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/ [R=301,L]
  RewriteRule ^kolpaki-dlya-dimohodnih-trub\.html$ https://metallomaster.by/catalog/chimney-caps/ [R=301,L]
  RewriteRule ^ocinkovannie-vozduhovodi\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/ [R=301,L]
  RewriteRule ^dobornie-elementi-dlya-krovli\.html$ https://metallomaster.by/catalog/roof-accessories/ [R=301,L]

  # Товары: дымоходы из нержавеющей стали
  RewriteRule ^uteplennie-dimohodi-iz-nerzhaveyuschej-stali\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/insulated-chimneys/ [R=301,L]
  RewriteRule ^odnostennie-dimohodi-kruglogo-i-ovaljnogo-secheniya\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^truba-dimohoda-ovaljnaya\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/oval-chimney-pipe/ [R=301,L]
  RewriteRule ^montazhnie-kronshtejni-i-homuti\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/brackets-and-clamps/ [R=301,L]
  RewriteRule ^prohodnie-uzli-i-stenovie-opori\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/wall-supports-and-pass-throughs/ [R=301,L]

  # Товары: колпаки
  RewriteRule ^zont-ventilyacionnij\.html$ https://metallomaster.by/catalog/chimney-caps/vent-cap/ [R=301,L]
  RewriteRule ^kolpak-na-stolb\.html$ https://metallomaster.by/catalog/chimney-caps/post-cap/ [R=301,L]
  RewriteRule ^deflektor-ventilyacionnij\.html$ https://metallomaster.by/catalog/chimney-caps/ventilation-deflector/ [R=301,L]
  RewriteRule ^dimnik\.html$ https://metallomaster.by/catalog/chimney-caps/brick-chimney-cap/ [R=301,L]

  # Товары: воздуховоды
  RewriteRule ^vozduhovodi-iz-nerzhaveyuschej-stali\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/stainless-steel-air-ducts/ [R=301,L]
  RewriteRule ^vityazhnoj-zont\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/exhaust-hood/ [R=301,L]
  RewriteRule ^truba-ventilyacionnaya-kruglaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^truba-ventilyacionnaya-pryamougoljnaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]

  # Товары: доборные элементы кровли
  RewriteRule ^konek-krovli\.html$ https://metallomaster.by/catalog/roof-accessories/roof-ridge/ [R=301,L]
  RewriteRule ^page-56\.html$ https://metallomaster.by/catalog/roof-accessories/parapet-cap/ [R=301,L]
  RewriteRule ^otliv-okonnij\.html$ https://metallomaster.by/catalog/roof-accessories/window-flashing/ [R=301,L]
  RewriteRule ^karniznaya-planka\.html$ https://metallomaster.by/catalog/roof-accessories/eaves-flashing/ [R=301,L]
  RewriteRule ^snegovoj-barjer\.html$ https://metallomaster.by/catalog/roof-accessories/snow-guard/ [R=301,L]
  RewriteRule ^torcevaya-planka\.html$ https://metallomaster.by/catalog/roof-accessories/gable-flashing/ [R=301,L]
  RewriteRule ^endova-nizhnyaya\.html$ https://metallomaster.by/catalog/roof-accessories/valley-flashing-bottom/ [R=301,L]
  RewriteRule ^endova-verhnyaya\.html$ https://metallomaster.by/catalog/roof-accessories/valley-flashing-top/ [R=301,L]

  # Услуги
  RewriteRule ^montazh-dimohoda\.html$ https://metallomaster.by/services/chimney-installation/ [R=301,L]
  RewriteRule ^ventilyacionnie-sistemi\.html$ https://metallomaster.by/catalog/ventilation-systems/ [R=301,L]


  # --- 1b. Старые адреса без прямого аналога (301 на ближайший раздел) --------
  # На старом сайте каждый фитинг имел свою страницу; в новом каталоге они описаны
  # внутри разделов. 301 ведёт в тот раздел, где изделие теперь описано: адрес не
  # выпадает из индекса, а посетитель попадает на страницу по своему запросу.
  # Пустой 404 здесь был бы дороже: это больше половины старого индекса.
  # Узлы одностенного дымохода: своих страниц у них теперь нет — ведём в раздел одностенных
  RewriteRule ^truba-dimohoda-kruglaya\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^trojnik-dimohoda-kruglij\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^trojnik-dimohoda-ovaljnij\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/oval-chimney-pipe/ [R=301,L]
  RewriteRule ^koleno-dimohoda-krugloe\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^koleno-dimohoda-ovaljnoe\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/oval-chimney-pipe/ [R=301,L]
  RewriteRule ^sbornik-kondensata-kruglij\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^sbornik-kondensata-ovaljnij\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/oval-chimney-pipe/ [R=301,L]
  RewriteRule ^perehod\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^shiber\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]

  # Узлы утеплённого дымохода — в раздел утеплённых
  RewriteRule ^truba-dimohoda-uteplennaya\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/insulated-chimneys/ [R=301,L]
  RewriteRule ^trojnik-dimohoda-uteplennij\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/insulated-chimneys/ [R=301,L]
  RewriteRule ^koleno-dimohoda-uteplennoe\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/insulated-chimneys/ [R=301,L]
  RewriteRule ^nakonechnik\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/insulated-chimneys/ [R=301,L]

  # Зонты дымохода — к зонтам и колпакам
  RewriteRule ^zont-dimohoda-kruglij\.html$ https://metallomaster.by/catalog/chimney-caps/vent-cap/ [R=301,L]
  RewriteRule ^zont-dimohoda-ovaljnij\.html$ https://metallomaster.by/catalog/chimney-caps/vent-cap/ [R=301,L]

  # Фитинги круглой вентиляции — в раздел круглых воздуховодов
  RewriteRule ^otvod-ventilyacionnij-kruglij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^trojnik-ventilyacionnij-kruglij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^krestovina-ventilyacionnaya-kruglaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^perehod-ventilyacionnij-kruglij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^vrezka-ventilyacionnaya-kruglaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^zaglushka-ventilyacionnaya-kruglaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^utka-ventilyacionnaya-kruglaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]
  RewriteRule ^drosselj-klapan-ventilyacionnij-kruglij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/round-air-duct/ [R=301,L]

  # Фитинги прямоугольной вентиляции — в раздел прямоугольных воздуховодов
  RewriteRule ^otvod-ventilyacionnij-pryamougoljnij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^trojnik-ventilyacionnij-pryamougoljnij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^krestovina-ventilyacionnaya-pryamougoljnaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^perehod-ventilyacionnij-pryamougoljnij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^vrezka-ventilyacionnaya-pryamougoljnaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^zaglushka-ventilyacionnaya-pryamougoljnaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^utka-ventilyacionnaya-pryamougoljnaya\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]
  RewriteRule ^drosselj-klapan-ventilyacionnij-pryamougoljnij\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/rectangular-air-duct/ [R=301,L]

  # Страницы, у которых в старом меню было только человеческое имя
  RewriteRule ^page-144\.html$ https://metallomaster.by/catalog/chimney-caps/ventilation-deflector/ [R=301,L]
  RewriteRule ^page-147\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/stainless-steel-air-ducts/ [R=301,L]
  RewriteRule ^page-152\.html$ https://metallomaster.by/catalog/galvanized-air-ducts/static-pressure-chamber/ [R=301,L]
  RewriteRule ^ventilation-dly-bani-i-sauni\.html$ https://metallomaster.by/catalog/bath-sauna-ventilation/ [R=301,L]

  # --- 1c. Страницы, найденные только на живом сервере -------------------------
  # Ни в зеркале, ни в старом sitemap.xml их не было — нашлись в imsitemap.html
  # и в листинге корня сайта. Все отдавали 200, поэтому им нужен 301.

  # Цен на новом сайте нет (решение владельца) — ведём в раздел про то же изделие
  RewriteRule ^cena-dimohoda-kruglogo-secheniya-(?:304|430)-(?:05|08|1)\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/single-wall-chimneys/ [R=301,L]
  RewriteRule ^cena-dimohoda-ovaljnogo-secheniya-(?:304|430)-(?:05|08|1)\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/oval-chimney-pipe/ [R=301,L]
  RewriteRule ^cena-sendvich-dimohoda-(?:304|430)-430-(?:05|08|1)-05\.html$ https://metallomaster.by/catalog/stainless-steel-chimneys/insulated-chimneys/ [R=301,L]
  RewriteRule ^cena-kolpaka-na-trubu-dimohoda\.html$ https://metallomaster.by/catalog/chimney-caps/ [R=301,L]

  # Водосточные системы
  RewriteRule ^vodostochnie-sistemi\.html$ https://metallomaster.by/catalog/gutter-systems/ [R=301,L]
  RewriteRule ^vodostoki-ocinkovannie\.html$ https://metallomaster.by/catalog/gutter-systems/ [R=301,L]
  RewriteRule ^metallicheskaya-vodostochnaya-sistema\.html$ https://metallomaster.by/catalog/gutter-systems/ [R=301,L]

  # Парапет: две страницы об одном и том же. Дефисы шаблоном — их точное число неважно
  RewriteRule ^parapet\.html$ https://metallomaster.by/catalog/roof-accessories/parapet-cap/ [R=301,L]
  RewriteRule ^new-+\.html$ https://metallomaster.by/catalog/roof-accessories/parapet-cap/ [R=301,L]

  # Вентиляция бани и сауны: ещё два служебных имени той же страницы
  RewriteRule ^page-147-1\.html$ https://metallomaster.by/catalog/bath-sauna-ventilation/ [R=301,L]
  RewriteRule ^page-151\.html$ https://metallomaster.by/catalog/bath-sauna-ventilation/ [R=301,L]

  # Карта старого сайта — ближайший аналог это витрина каталога
  RewriteRule ^imsitemap\.html$ https://metallomaster.by/catalog/ [R=301,L]

  # Правило: страница отдавала 200 — ей нужен 301; не существовала — пусть будет 404.
  # Массовый редирект «всё непонятное на главную» поисковики считают soft-404.

  # --- 2. Схема и хост -----------------------------------------------------
  # http → https. Второе условие обязательно для хостингов, где TLS терминируется
  # на прокси: там %{HTTPS} всегда off, и без проверки X-Forwarded-Proto
  # получается бесконечный цикл редиректов.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://metallomaster.by%{REQUEST_URI} [R=301,L]

  # www → без www (канонический хост — тот же, что в canonical и sitemap).
  # Хост в цели зашит намеренно: подстановка %1 из Host отправляла бы посетителя
  # туда, куда указано в присланном заголовке, — открытый редирект с нашего домена.
  RewriteCond %{HTTP_HOST} ^www\.metallomaster\.by$ [NC]
  RewriteRule ^ https://metallomaster.by%{REQUEST_URI} [R=301,L]

  # Адрес каталога без завершающего слеша (у нас trailingSlash: 'always').
  # Слеш добавляем сами, абсолютным https-адресом: встроенный DirectorySlash
  # отдаёт Location вида http://host:port/path/ — за прокси это лишний переход.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://metallomaster.by/$1/ [R=301,L]
</IfModule>

# --- 3. Страница 404 -------------------------------------------------------
ErrorDocument 404 /404.html

# --- 4. Заголовки безопасности ---------------------------------------------
<IfModule mod_headers.c>
  # Браузер не угадывает тип файла по содержимому
  Header always set X-Content-Type-Options "nosniff"

  # Сайт нельзя показать в чужом фрейме
  Header always set X-Frame-Options "DENY"

  # В чужие домены уходит только источник, внутри сайта — полный адрес
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Отключаем API, которыми сайт не пользуется. interest-cohort намеренно нет:
  # Google свернул Topics в 2025, директива мёртвая.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), midi=()"

  # Изоляция окна и ресурсов. COEP намеренно НЕ ставим: он сломает будущий виджет карт,
  # а выгоды для статического сайта не даёт.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # HSTS: срок намеренно начат с малого. Пока стоит 300 секунд, ошибку с сертификатом
  # можно откатить за пять минут; при max-age=2 года браузеры будут помнить требование
  # https ещё два года, и откатиться уже не получится. Убедились, что https работает
  # на домене и всех поддоменах — меняем значение на: max-age=63072000; includeSubDomains
  # preload НЕ добавляем: сам hstspreload.org больше его не рекомендует.
  Header always set Strict-Transport-Security "max-age=300"

  # CSP. Скрипты и стили сборка отдаёт только внешними файлами — за это отвечают
  # build.inlineStylesheets: 'never' и vite.build.assetsInlineLimit: 0 в astro.config.ts.
  # Не меняй эти настройки, не поправив заголовок: при инлайне 'self' заблокирует
  # меню, лайтбокс и форму заявки.
  # 'inline-speculation-rules' обязателен: правило предзагрузки страниц из
  # src/lib/speculation.ts инлайновое по определению.
  # JSON-LD в 'self' не нуждается: неисполняемый тип application/ld+json под script-src
  # не попадает.
  # connect-src пускает api.web3forms.com — туда уходит fetch с заявкой.
  # Режим боевой. В -Report-Only держать нельзя: директиву upgrade-insecure-requests
  # спецификация в режиме отчётов игнорирует, и браузер ругается на неё в консоли.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# --- 5. Кэширование --------------------------------------------------------
<IfModule mod_headers.c>
  # Хэшированные ассеты Astro: имя файла меняется при любой правке, поэтому кэш навсегда
  <FilesMatch "\.(?:js|css|avif|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — короткий: адреса страниц постоянны, содержимое меняется. Браузер обязан
  # переспросить сервер, иначе правки контента не доедут до вернувшихся посетителей.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Служебные файлы: час, чтобы правки robots и карты сайта подхватывались быстро
  <FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Иконки: имена без хэша, меняются раз в никогда
  <FilesMatch "^(favicon\.ico|favicon\.svg|apple-touch-icon\.png|icon-.*\.png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --- 6. Сжатие -------------------------------------------------------------
# Картинки и шрифты не сжимаем: webp, avif и woff2 уже сжаты, второй проход
# только греет процессор.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- 7. Типы файлов --------------------------------------------------------
# На старых сборках Apache этих типов нет, и браузер получает octet-stream.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --- 8. Служебные файлы ---------------------------------------------------
# Страховка от неаккуратного деплоя, если mod_rewrite на сервере выключен и правило
# из раздела 0 не сработало. FilesMatch сверяется с именем файла, поэтому закрывает
# только сами точечные файлы, но не содержимое каталога .git — основная защита
# всё-таки в разделе 0.
<FilesMatch "^\.(?:env|git|htaccess)">
  Require all denied
</FilesMatch>
