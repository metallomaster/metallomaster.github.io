---
/* Временная главная для проверки каркаса — будет заменена на этапе 2 */
import BaseLayout from '@app/layouts/base-layout.astro';
import { Button, Container } from '@shared/ui';
---

<BaseLayout
  title="Изделия из металла в Минске: дымоходы, колпаки, воздуховоды"
  description="Производство изделий из листовой стали в Минске: нержавеющие дымоходы, колпаки на трубы, оцинкованные воздуховоды, доборные элементы кровли. Изготовим по вашим размерам."
  path="/"
>
  <Container>
    <section class="hero">
      <h1>Изделия из металла по вашим размерам</h1>
      <p>
        Дымоходы, колпаки, воздуховоды и доборные элементы кровли — собственное производство в
        Минске.
      </p>
      <Button href="/zakazatj.html" size="lg">Рассчитать стоимость</Button>
    </section>
  </Container>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: var(--space-9);
  }

  .hero h1 {
    font-size: var(--text-3xl);
    max-width: 18ch;
  }

  .hero p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 44ch;
  }
</style>
