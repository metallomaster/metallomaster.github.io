---
import { getFeatured, getWorks } from '@/lib/content';
import BaseLayout from '@/layouts/base-layout.astro';
import Lightbox from '@/components/organisms/lightbox.astro';
import Advantages from '@/components/organisms/advantages.astro';
import CategoryGrid from '@/components/organisms/category-grid.astro';
import CtaBand from '@/components/organisms/cta-band.astro';
import Hero from '@/components/organisms/hero.astro';
import HowWeWork from '@/components/organisms/how-we-work.astro';
import WorksGallery from '@/components/organisms/works-gallery.astro';
import Button from '@/components/atoms/button.astro';

const featured = await getFeatured();
const works = await getWorks();
---

<BaseLayout
  title="Изделия из металла в Минске: дымоходы, колпаки, воздуховоды"
  description="Производство изделий из листовой стали в Минске: нержавеющие дымоходы, колпаки на трубы, оцинкованные воздуховоды, доборные элементы кровли. Изготовим по вашим размерам."
  path="/"
>
  <Hero
    title="Изделия из металла по вашим размерам"
    lead="Дымоходы, колпаки, воздуховоды и доборные элементы кровли — собственное производство в Минске. Стандартные изделия и сложные индивидуальные заказы."
  >
    <Button href="/order/" size="lg">Рассчитать стоимость</Button>
    <Button href="/catalog/" variant="outline" size="lg">Смотреть каталог</Button>
  </Hero>

  {featured.length > 0 && <CategoryGrid items={featured} heading="Что мы изготавливаем" />}

  {works.length > 0 && <WorksGallery images={works} heading="Наши работы" />}

  <HowWeWork />

  <Advantages />

  <CtaBand />

  <Lightbox />
</BaseLayout>
