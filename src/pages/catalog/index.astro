---
import { getCatalogItems } from '@/lib/content';
import BaseLayout from '@/components/templates/base-layout.astro';
import CategoryGrid from '@/components/organisms/category-grid.astro';
import CtaBand from '@/components/organisms/cta-band.astro';
import { siteConfig } from '@/config/site';
import { breadcrumbsJsonLd } from '@/lib/seo';
import Container from '@/components/atoms/container.astro';

const items = await getCatalogItems();
const categories = items.filter((item) => item.type === 'category');

const jsonLd = [
  breadcrumbsJsonLd(siteConfig.siteUrl, [
    { name: 'Главная', path: '/' },
    { name: 'Каталог продукции', path: '/catalog/' },
  ]),
];
---

<BaseLayout
  title="Каталог металлоизделий: дымоходы, колпаки, воздуховоды"
  description="Каталог продукции METALLOMASTER: дымоходы из нержавеющей стали, колпаки на трубы и столбы, оцинкованные воздуховоды, доборные элементы кровли. Производство в Минске."
  path="/catalog/"
  jsonLd={jsonLd}
>
  <Container>
    <div class="page-head">
      <h1>Каталог продукции</h1>
      <p class="page-head__lead">
        Изготавливаем изделия из оцинкованной и нержавеющей стали, металла с полимерным покрытием —
        по стандартным и вашим размерам.
      </p>
    </div>
  </Container>

  <CategoryGrid items={categories} aboveFold />

  <CtaBand
    title="Не нашли нужное изделие?"
    subtitle="Изготовим по вашему эскизу или фотографии — позвоните, поможем с размерами."
  />
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-2);
  }

  .page-head h1 {
    font-size: var(--text-2xl);
  }

  .page-head__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 60ch;
  }
</style>
