---
import { getCatalogEntryWithContent, getCatalogItems, getProductsOf } from '@app/content/catalog';
import BaseLayout from '@app/layouts/base-layout.astro';
import { Lightbox } from '@features/lightbox';
import { CategoryGrid } from '@widgets/category-grid';
import { CtaBand } from '@widgets/cta-band';
import { WorksGallery } from '@widgets/works-gallery';
import { catalogItemUrl } from '@entities/catalog-item';
import { siteConfig } from '@shared/config';
import { breadcrumbsJsonLd, productJsonLd } from '@shared/seo';
import { Breadcrumbs, Container } from '@shared/ui';
import type { Crumb } from '@shared/ui';

export async function getStaticPaths() {
  const items = await getCatalogItems();
  return items
    .filter((item) => item.type === 'product')
    .map((item) => ({ params: { category: item.category, product: item.slug } }));
}

const { product } = Astro.params;
const entry = await getCatalogEntryWithContent(product);
if (!entry) throw new Error(`Нет контента для товара ${product}`);
const { item, Content } = entry;

const items = await getCatalogItems();
const parent = items.find((i) => i.slug === item.category);
const related = item.category
  ? (await getProductsOf(item.category)).filter((i) => i.slug !== item.slug)
  : [];

const crumbs: Crumb[] = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  ...(parent ? [{ label: parent.navTitle, href: catalogItemUrl(parent) }] : []),
  { label: item.navTitle },
];

const path = catalogItemUrl(item);
const jsonLd: object[] = [
  breadcrumbsJsonLd(
    siteConfig.siteUrl,
    crumbs.map((crumb) => ({ name: crumb.label, path: crumb.href ?? path })),
  ),
  productJsonLd({
    name: item.title,
    description: item.description,
    url: new URL(path, siteConfig.siteUrl).toString(),
    images: item.images.map((img) => new URL(img.src.src, siteConfig.siteUrl).toString()),
    brand: siteConfig.name,
  }),
];
---

<BaseLayout
  title={item.seoTitle}
  description={item.description}
  path={path}
  ogImage={item.cover?.src.src}
  jsonLd={jsonLd}
>
  <Container>
    <div class="page-head">
      <Breadcrumbs items={crumbs} />
      <h1>{item.title}</h1>
      <p class="page-head__lead">{item.lead}</p>
    </div>
  </Container>

  {item.images.length > 0 && <WorksGallery images={item.images} heading="Фотографии изделий" />}

  <Container>
    <div class="prose">
      <Content />
    </div>
  </Container>

  {related.length > 0 && <CategoryGrid items={related} heading="Из этого же раздела" />}

  <CtaBand
    title={`Нужно изделие «${item.navTitle.toLowerCase()}»?`}
    subtitle="Рассчитаем стоимость по вашим размерам и изготовим в короткий срок."
  />

  {item.images.length > 0 && <Lightbox />}
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-2);
  }

  .page-head h1 {
    font-size: var(--text-2xl);
  }

  .page-head__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .prose {
    max-width: 72ch;
    padding-block: var(--space-6);
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
    margin-block: var(--space-6) var(--space-4);
  }

  .prose :global(p) {
    margin-block-end: var(--space-4);
  }

  .prose :global(ul) {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .prose :global(li)::marker {
    color: var(--color-accent);
  }
</style>
