---
import BaseLayout from '@app/layouts/base-layout.astro';
import { OrderForm } from '@features/order-form';
import { ContactInfo } from '@widgets/contact-info';
import { Container } from '@shared/ui';
---

<BaseLayout
  title="Заказать изделие из металла — расчёт стоимости"
  description="Оставьте заявку на изготовление изделия из листовой стали: перезвоним, поможем с размерами и назовём точную цену. Дымоходы, колпаки, воздуховоды — производство в Минске."
  path="/order/"
>
  <Container>
    <section class="order">
      <div class="order__intro">
        <h1>Рассчитать стоимость изделия</h1>
        <p>
          Опишите, что нужно изготовить, — перезвоним в рабочее время, поможем определиться с
          размерами и материалом и назовём точную цену.
        </p>
      </div>

      <div class="order__grid">
        <OrderForm />
        <aside class="order__aside" aria-label="Контакты">
          <ContactInfo />
          <p class="order__aside-note">
            Удобнее говорить, чем писать? Звоните — посчитаем стоимость прямо по телефону.
          </p>
        </aside>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .order {
    padding-block: var(--space-7) var(--space-9);
  }

  .order__intro {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .order__intro h1 {
    font-size: var(--text-2xl);
  }

  .order__intro p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .order__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .order__aside {
    display: grid;
    gap: var(--space-4);
  }

  .order__aside-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-inline: var(--space-2);
  }

  @media (min-width: 1024px) {
    .order__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-7);
    }
  }
</style>
