---
import BaseLayout from '@/components/templates/base-layout.astro';
import OrderForm from '@/components/organisms/order-form.astro';
import Container from '@/components/atoms/container.astro';
---

<BaseLayout
  title="Расчёт стоимости изделия из металла"
  description="Оставьте заявку на изготовление изделия из листовой стали: перезвоним, поможем с размерами и назовём точную цену. Дымоходы, колпаки, воздуховоды — производство в Минске."
  path="/order/"
>
  <Container>
    <section class="order">
      <div class="order__intro">
        <h1>Рассчитать стоимость изделия</h1>
        <p>
          Опишите, что нужно изготовить, — перезвоним в рабочее время, поможем определиться с
          размерами и материалом и назовём точную цену.
        </p>
      </div>

      <OrderForm />
    </section>
  </Container>
</BaseLayout>

<style>
  .order {
    padding-block: var(--space-7) var(--space-9);
  }

  .order__intro {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .order__intro h1 {
    font-size: var(--text-2xl);
  }

  .order__intro p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 52ch;
  }
</style>
