---
import BaseLayout from '@/components/templates/base-layout.astro';
import Button from '@/components/atoms/button.astro';
import Container from '@/components/atoms/container.astro';
---

<BaseLayout
  title="Ошибка 404: такой страницы нет"
  description="Страница не найдена. Возможно, её переместили или удалили. Вернитесь на главную или посмотрите каталог изделий из металла METALLOMASTER."
  path="/404/"
  noindex
>
  <Container>
    <section class="not-found">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>Страница не найдена</h1>
      <p class="not-found__text">
        Возможно, страницу переместили или в адресе опечатка. Начните с главной или загляните в
        каталог — там всё, что мы делаем.
      </p>
      <div class="not-found__actions">
        <Button href="/" size="lg">На главную</Button>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--space-9);
  }

  .not-found__code {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .not-found h1 {
    font-size: var(--text-2xl);
  }

  .not-found__text {
    color: var(--color-text-muted);
    max-width: 44ch;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
