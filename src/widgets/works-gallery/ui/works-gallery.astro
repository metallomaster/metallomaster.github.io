---
import type { CatalogImage } from '@entities/catalog-item';
import { Container } from '@shared/ui';
import { Picture } from '@shared/ui/picture';

interface Props {
  images: CatalogImage[];
  heading?: string;
}

const { images, heading = 'Наши работы' } = Astro.props;
---

<section class="works-gallery">
  <Container>
    <h2 class="works-gallery__heading">{heading}</h2>
    <ul class="works-gallery__grid">
      {
        images.map((image) => (
          <li>
            {/* href на оптимизированный оригинал — его откроет лайтбокс */}
            <a class="works-gallery__link" href={image.src.src} data-lightbox-group="works">
              <Picture
                src={image.src}
                alt={image.alt}
                widths={[240, 360, 480, 720]}
                sizes="(max-width: 767px) 50vw, (max-width: 1023px) 33vw, (max-width: 1439px) 25vw, 200px"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .works-gallery {
    padding-block: var(--space-8);
    background: var(--color-surface);
  }

  .works-gallery__heading {
    margin-block-end: var(--space-6);
    font-size: var(--text-2xl);
  }

  .works-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .works-gallery__link {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    transition: border-color var(--transition-fast);
  }

  .works-gallery__link:hover {
    border-color: var(--color-accent);
  }

  .works-gallery__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .works-gallery__link:hover :global(img) {
    transform: scale(1.04);
  }

  @media (min-width: 768px) {
    .works-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .works-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1440px) {
    .works-gallery__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
