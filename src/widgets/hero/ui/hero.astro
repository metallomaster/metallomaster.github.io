---
import { Container } from '@shared/ui';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class:list={['hero', hasMedia && 'hero--with-media']}>
  <Container class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">{title}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="hero__actions">
        <slot />
      </div>
    </div>
    {
      hasMedia && (
        <div class="hero__media">
          <slot name="media" />
        </div>
      )
    }
  </Container>
</section>

<style>
  .hero {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .hero :global(.hero__inner) {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .hero__title {
    font-size: var(--text-3xl);
  }

  /* Красная линия — сдержанный индустриальный акцент */
  .hero__title::before {
    content: '';
    display: block;
    width: var(--space-8);
    height: var(--space-1);
    margin-block-end: var(--space-4);
    background: var(--color-accent);
  }

  .hero__lead {
    max-width: 60ch;
    margin-block-start: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__actions:empty {
    display: none;
  }

  /* Декоративная медиа-зона — только на десктопе */
  .hero__media {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero--with-media :global(.hero__inner) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-8);
    }

    .hero__media {
      position: relative;
      display: block;
    }

    /* Тонкая полосатая текстура за медиа-зоной */
    .hero__media::before {
      content: '';
      position: absolute;
      inset: var(--space-5) calc(-1 * var(--space-4)) calc(-1 * var(--space-4)) var(--space-5);
      border-radius: var(--radius-lg);
      background: repeating-linear-gradient(
        -45deg,
        var(--color-surface-2) 0 2px,
        transparent 2px 10px
      );
    }

    .hero__media > :global(*) {
      position: relative;
    }
  }
</style>
