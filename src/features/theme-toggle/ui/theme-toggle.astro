---
/* Кнопка «светлая/тёмная». Без data-theme на <html> тема берётся с устройства. */
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Переключить тему">
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
    ></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .theme-toggle:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .theme-toggle__icon {
    width: 20px;
    height: 20px;
  }

  /* Показываем иконку темы, НА которую переключит клик */
  .theme-toggle__icon--sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__icon--sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .theme-toggle__icon--moon {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    display: none;
  }
</style>

<script>
  import { initThemeToggle } from '../model/theme';

  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(initThemeToggle);
</script>
