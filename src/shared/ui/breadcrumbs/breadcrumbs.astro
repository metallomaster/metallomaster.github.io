---
export interface Crumb {
  label: string;
  /** Последняя крошка — без ссылки */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <ol class="breadcrumbs__list">
    {
      items.map((item, i) => (
        <li class="breadcrumbs__item">
          {item.href ? (
            <a class="breadcrumbs__link" href={item.href}>
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {i < items.length - 1 && (
            <span class="breadcrumbs__sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .breadcrumbs__item {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
  }

  .breadcrumbs__link {
    text-decoration: none;
  }

  .breadcrumbs__link:hover {
    color: var(--color-accent);
  }

  .breadcrumbs__sep {
    color: var(--color-border);
  }
</style>
