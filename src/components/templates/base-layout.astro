---
import '@/config/global.css';
import { getImage } from 'astro:assets';
import Footer from '@/components/organisms/footer.astro';
import Header from '@/components/organisms/header.astro';
import TabBar from '@/components/organisms/tab-bar.astro';
import { siteConfig } from '@/config/site';
import { getDefaultShareImage } from '@/lib/content';
import { OG_IMAGE } from '@/lib/images';
import {
  buildTitle,
  canonicalUrl,
  clampDescription,
  jsonLdText,
  organizationJsonLd,
} from '@/lib/seo';
import type { PageSeo } from '@/lib/seo';
import { speculationRules } from '@/lib/speculation';

interface Props extends PageSeo {
  /** Дополнительные JSON-LD объекты страницы (Product, BreadcrumbList и т.д.) */
  jsonLd?: object[];
}

const {
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = buildTitle(title);
const metaDescription = clampDescription(description);
const canonical = canonicalUrl(siteConfig.siteUrl, path);

/* Превью для соцсетей: своё фото страницы, иначе общее по сайту */
const shareSource = ogImage ?? (await getDefaultShareImage());
const shareImage = shareSource ? await getImage({ src: shareSource, ...OG_IMAGE }) : undefined;
const ogImageUrl = shareImage ? new URL(shareImage.src, siteConfig.siteUrl).toString() : undefined;

const organization = organizationJsonLd({
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  logoUrl: `${siteConfig.siteUrl}/favicon.svg`,
  phone: siteConfig.phoneHref,
  email: siteConfig.email,
  address: siteConfig.address,
  geo: siteConfig.geo,
  taxID: siteConfig.unp,
  openingHours: siteConfig.openingHours,
});

const jsonLdBlocks = [organization, ...jsonLd];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover — иначе env(safe-area-inset-*) всегда 0 и вырезы экрана не учесть */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    {
      /* Крупные превью фото в выдаче и Discover; текст и переходы не ограничиваем.
        follow остаётся и у noindex-страниц: ссылки с них ведут на нужные разделы. */
    }
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />

    {/* .ico ради Яндекса и старых браузеров, .svg — везде, где понимают вектор */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* display: standalone из манифеста понимает iOS 15.4+; для более старых — этот мета-тег */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="METALLOMASTER" />
    {/* Цвет строки браузера на Android — совпадает с --color-bg обеих тем */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12141a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    {
      shareImage && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content={String(shareImage.attributes.width)} />
          <meta property="og:image:height" content={String(shareImage.attributes.height)} />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/manrope-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Предзагрузка внутренних страниц при наведении — см. src/lib/speculation.ts */}
    <script is:inline type="speculationrules" set:html={jsonLdText(speculationRules)} />

    {/* is:inline — разметка для поисковиков идёт в страницу как есть, без сборки */}
    {
      jsonLdBlocks.map((block) => (
        <script is:inline type="application/ld+json" set:html={jsonLdText(block)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    {
      /* tabindex="-1" — чтобы после skip-link фокус реально уезжал в контент:
        без него браузер только прокручивает страницу, а скринридер остаётся в шапке */
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <TabBar />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  /* Таб-бар зафиксирован поверх страницы — иначе он накрыл бы конец футера */
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(var(--tab-bar-height) + var(--safe-bottom));
    }
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 200;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-weight: 700;
  }

  .skip-link:focus-visible {
    top: var(--space-2);
  }

  /* Рамка вокруг всего контента ничего не сообщает: цель перехода видна по заголовку,
     а следующий Tab покажет фокус там, где он полезен */
  #main:focus-visible {
    outline: none;
  }
</style>
