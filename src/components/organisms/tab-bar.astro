---
/*
 * Нижний таб-бар — навигация для узких экранов вместо бургер-меню.
 * Разделы всегда на виду и под большим пальцем, ничего не нужно открывать.
 * На ширине от 1024px скрыт: там ту же навигацию показывает шапка.
 */
import { isCurrentPath, navItems, normalizePath } from '@/lib/menu';
import type { NavIcon } from '@/lib/menu';

/* Контуры иконок 24×24: тот же штриховой стиль, что у иконки звонка в шапке */
const icons: Record<NavIcon, string[]> = {
  home: ['M3 9.2 12 2l9 7.2V20a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M9.5 22v-7.5h5V22'],
  catalog: ['M3.5 3.5h7v7h-7z', 'M13.5 3.5h7v7h-7z', 'M3.5 13.5h7v7h-7z', 'M13.5 13.5h7v7h-7z'],
  services: [
    'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z',
  ],
  contacts: [
    'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z',
    'M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  ],
};

const currentPath = normalizePath(Astro.url.pathname);
---

<nav class="tab-bar" aria-label="Основная навигация">
  <ul class="tab-bar__list">
    {
      navItems.map((item) => (
        <li class="tab-bar__item">
          <a
            class="tab-bar__link"
            href={item.href}
            aria-current={isCurrentPath(item.href, currentPath) ? 'page' : undefined}
          >
            <svg
              class="tab-bar__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {icons[item.icon].map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span class="tab-bar__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tab-bar {
    display: none;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    /* Вырезы экрана: фон панели уходит под полосу home-indicator и «уши» в ландшафте,
       а сами кнопки поднимаются выше — иначе по нижнему ряду не попасть */
    padding-block-end: var(--safe-bottom);
    padding-inline: var(--safe-left) var(--safe-right);
  }

  .tab-bar__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    list-style: none;
    padding: 0;
    /* Панель во всю ширину, но на планшете растягивать кнопки до края незачем */
    max-width: 32rem;
    margin-inline: auto;
  }

  .tab-bar__item {
    display: flex;
  }

  .tab-bar__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: var(--tab-bar-height);
    padding: var(--space-2) var(--space-1);
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.2;
    transition: color var(--transition-fast);
  }

  .tab-bar__link[aria-current='page'] {
    color: var(--color-accent);
  }

  .tab-bar__icon {
    width: 24px;
    height: 24px;
  }

  .tab-bar__label {
    /* Длинную подпись лучше поджать, чем перенести на вторую строку */
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .tab-bar {
      display: block;
    }
  }
</style>
