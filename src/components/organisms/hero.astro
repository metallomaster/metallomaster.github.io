---
import Container from '@/components/atoms/container.astro';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<section class="hero">
  <Container class="hero__inner">
    <h1 class="hero__title">{title}</h1>
    <p class="hero__lead">{lead}</p>
    <div class="hero__actions">
      <slot />
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  /* Полосатая текстура металла — заполняет правую часть экрана вместо фото.
     Маске важна только альфа, поэтому currentColor вместо сырого цвета. */
  .hero::after {
    content: '';
    position: absolute;
    display: none;
    inset-block: 0;
    inset-inline-end: 0;
    width: 40%;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-surface-2) 0 2px,
      transparent 2px 10px
    );
    mask-image: linear-gradient(to right, transparent, currentColor 70%);
    pointer-events: none;
  }

  .hero :global(.hero__inner) {
    /* Над текстурой: иначе полосы перечёркивают кнопки */
    position: relative;
    z-index: 1;
    display: grid;
    row-gap: var(--space-5);
    padding-block: var(--space-8);
  }

  .hero__title {
    font-size: var(--text-3xl);
  }

  /* Красная линия — сдержанный индустриальный акцент */
  .hero__title::before {
    content: '';
    display: block;
    width: var(--space-8);
    height: var(--space-1);
    margin-block-end: var(--space-4);
    background: var(--color-accent);
  }

  .hero__lead {
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__actions:empty {
    display: none;
  }

  /* Плакатная композиция: заголовок, лид и кнопки одной колонкой слева */
  @media (min-width: 1024px) {
    .hero::after {
      display: block;
    }

    .hero :global(.hero__inner) {
      row-gap: var(--space-6);
      padding-block: var(--space-9);
    }

    .hero__title {
      max-width: 16ch;
    }

    .hero__lead {
      max-width: 52ch;
    }
  }
</style>
