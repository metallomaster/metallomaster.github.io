---
import { siteConfig } from '@/config/site';
import Button from '@/components/atoms/button.astro';
import Container from '@/components/atoms/container.astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Нужно изделие из металла?',
  subtitle = 'Позвоните или оставьте заявку — посчитаем стоимость и назовём срок.',
} = Astro.props;
---

<section class="cta-band">
  <Container>
    <div class="cta-band__panel">
      <div class="cta-band__text">
        <h2 class="cta-band__title">{title}</h2>
        <p class="cta-band__subtitle">{subtitle}</p>
      </div>
      <div class="cta-band__actions">
        <a class="cta-band__phone" href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>
        <Button href="/order/" size="lg">Рассчитать стоимость</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .cta-band {
    padding-block: var(--space-8);
  }

  .cta-band__panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    /* Красный акцент на кромке панели */
    border-inline-start: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .cta-band__title {
    font-size: var(--text-xl);
  }

  .cta-band__subtitle {
    max-width: 48ch;
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .cta-band__phone {
    /* Номер рядом с кнопкой — такой же тач-таргет, как кнопка: 44 px по высоте */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-xl);
    font-weight: 800;
    text-decoration: none;
  }

  .cta-band__phone:hover {
    color: var(--color-accent);
  }

  /* Узкие экраны: компактнее панель и номер, чтобы всё умещалось без переноса */
  @media (max-width: 480px) {
    .cta-band__panel {
      padding: var(--space-5);
    }

    .cta-band__phone {
      font-size: var(--text-lg);
    }
  }
</style>
