---
import CatalogCard from '@/components/molecules/catalog-card.astro';
import type { CatalogItem } from '@/lib/types';
import Container from '@/components/atoms/container.astro';

interface Props {
  items: CatalogItem[];
  heading?: string;
  /** Сетка на первом экране: первая обложка — кандидат в LCP, грузим её без задержки */
  aboveFold?: boolean;
}

const { items, heading, aboveFold = false } = Astro.props;
---

<section class="category-grid">
  <Container>
    {heading && <h2 class="category-grid__heading">{heading}</h2>}
    <ul class="category-grid__list">
      {
        items.map((item, index) => (
          <li class="category-grid__cell">
            <CatalogCard item={item} priority={aboveFold && index === 0} />
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .category-grid {
    padding-block: var(--space-8);
  }

  .category-grid__heading {
    margin-block-end: var(--space-6);
    font-size: var(--text-2xl);
  }

  .category-grid__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* Карточка растягивается на всю высоту ячейки */
  .category-grid__cell {
    display: grid;
  }

  @media (min-width: 768px) {
    .category-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .category-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1440px) {
    .category-grid__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
