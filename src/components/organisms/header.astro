---
import { siteConfig } from '@/config/site';
import Container from '@/components/atoms/container.astro';
import Logo from '@/components/atoms/logo.astro';
import { isCurrentPath, navItems, normalizePath } from '@/lib/menu';

const currentPath = normalizePath(Astro.url.pathname);
---

<header class="header">
  <Container class="header__inner">
    <a class="header__logo" href="/" aria-label="METALLOMASTER — на главную">
      <Logo idPrefix="header-logo" />
    </a>

    {
      /* Меню шапки — только для широких экранов. На узких его место занимает
        нижний таб-бар (@/components/organisms/tab-bar.astro): там разделы
        всегда на виду, ничего не нужно открывать. */
    }
    <nav class="header__nav" aria-label="Основная навигация">
      <ul class="header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="header__nav-link"
                href={item.href}
                aria-current={isCurrentPath(item.href, currentPath) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>
      {
        /* Кнопка звонка для узких экранов: номер целиком там не помещается,
          а звонок — основной канал заказа, прятать его нельзя. */
      }
      <a
        class="header__call"
        href={`tel:${siteConfig.phoneHref}`}
        aria-label={`Позвонить: ${siteConfig.phone}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"
          ></path>
        </svg>
      </a>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    /* В standalone-режиме шапка упирается в самый верх экрана: подкладываем
       её фон под статус-бар, иначе логотип уезжает под часы */
    padding-top: var(--safe-top);
  }

  .header :global(.header__inner) {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-height);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    /* Тач-таргет: сама надпись 43 px, до требуемых 44 не хватало пикселя */
    min-height: 44px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__nav {
    margin-inline-start: auto;
  }

  .header__nav-list {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .header__nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-text);
  }

  .header__nav-link[aria-current='page'] {
    color: var(--color-accent);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__phone {
    /* Строка текста даёт 24 px по высоте — добираем до тач-таргета 44 px */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 800;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__phone:hover {
    color: var(--color-accent);
  }

  /* На широких экранах номер виден цифрами — иконка не нужна */
  .header__call {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .header__call:hover {
    border-color: var(--color-accent);
  }

  .header__call svg {
    width: 22px;
    height: 22px;
  }

  /* Узкие экраны: в шапке остаются логотип и звонок, разделы уходят в таб-бар */
  @media (max-width: 1023px) {
    .header__nav,
    .header__phone {
      display: none;
    }

    .header__actions {
      margin-inline-start: auto;
    }

    .header__call {
      display: inline-flex;
    }
  }
</style>
