---
import { siteConfig } from '@/config/site';
import Container from '@/components/atoms/container.astro';
import Logo from '@/components/atoms/logo.astro';

const navItems = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
  { label: 'Услуги', href: '/services/' },
  { label: 'Контакты', href: '/contacts/' },
];

// Нормализуем путь к виду с завершающим слешем (trailingSlash: 'always')
const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header" data-menu-open="false">
  <Container class="header__inner">
    <a class="header__logo" href="/" aria-label="METALLOMASTER — на главную">
      <Logo idPrefix="header-logo" />
    </a>

    <nav class="header__nav" aria-label="Основная навигация" data-menu-panel>
      <ul class="header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="header__nav-link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="header__phone header__phone--mobile" href={`tel:${siteConfig.phoneHref}`}>
        {siteConfig.phone}
      </a>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>
      {
        /* Кнопка звонка для узких экранов: там номер целиком не помещается, а прятать
          единственный способ позвонить внутрь бургера нельзя — звонок здесь основной
          канал заказа. Внутри меню номер остаётся цифрами, чтобы его можно было прочесть. */
      }
      <a
        class="header__call"
        href={`tel:${siteConfig.phoneHref}`}
        aria-label={`Позвонить: ${siteConfig.phone}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"
          ></path>
        </svg>
      </a>
      <button
        class="header__burger"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-label="Открыть меню"
      >
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
        <span class="header__burger-line"></span>
      </button>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header :global(.header__inner) {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-height);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    /* Тач-таргет: сама надпись 43 px, до требуемых 44 не хватало пикселя */
    min-height: 44px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__nav {
    margin-inline-start: auto;
  }

  .header__nav-list {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .header__nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-text);
  }

  .header__nav-link[aria-current='page'] {
    color: var(--color-accent);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__phone {
    /* Строка текста даёт 24 px по высоте — добираем до тач-таргета 44 px */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 800;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__phone:hover {
    color: var(--color-accent);
  }

  .header__phone--mobile {
    display: none;
  }

  /* На широких экранах номер виден цифрами — иконка не нужна */
  .header__call {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .header__call:hover {
    border-color: var(--color-accent);
  }

  .header__call svg {
    width: 22px;
    height: 22px;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    width: 44px;
    height: 44px;
    padding: var(--space-2);
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    cursor: pointer;
  }

  .header__burger-line {
    height: 2px;
    width: 100%;
    background: var(--color-text);
    border-radius: 1px;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  @media (max-width: 1023px) {
    .header__phone:not(.header__phone--mobile) {
      display: none;
    }

    /* На узких экранах в строке только логотип и бургер справа */
    .header__actions {
      margin-inline-start: auto;
    }

    .header__burger {
      display: flex;
    }

    .header__call {
      display: inline-flex;
    }

    .header__nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: none;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      padding: var(--space-4) var(--container-pad) var(--space-5);
    }

    .header[data-menu-open='true'] .header__nav {
      display: block;
    }

    .header[data-menu-open='true'] .header__burger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .header[data-menu-open='true'] .header__burger-line:nth-child(2) {
      opacity: 0;
    }

    .header[data-menu-open='true'] .header__burger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .header__nav-list {
      flex-direction: column;
      gap: 0;
    }

    .header__nav-link {
      width: 100%;
      min-height: 48px;
      font-size: var(--text-base);
    }

    .header__phone--mobile {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      padding: var(--space-1) var(--space-3);
      color: var(--color-accent);
    }
  }
</style>

<script>
  import { initMobileMenu } from '@/lib/menu';

  document.querySelectorAll<HTMLElement>('.header').forEach(initMobileMenu);
</script>
