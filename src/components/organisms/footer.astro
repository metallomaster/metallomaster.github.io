---
import { siteConfig } from '@/config/site';
import Container from '@/components/atoms/container.astro';
import Logo from '@/components/atoms/logo.astro';
import { formatOpeningHours } from '@/lib/schedule';

const catalogLinks = [
  { label: 'Вентиляционные системы', href: '/catalog/ventilation-systems/' },
  { label: 'Оцинкованные воздуховоды', href: '/catalog/galvanized-air-ducts/' },
  { label: 'Дымоходы из нержавеющей стали', href: '/catalog/stainless-steel-chimneys/' },
  { label: 'Вентиляция бани и сауны', href: '/catalog/bath-sauna-ventilation/' },
  { label: 'Колпаки для дымоходных труб', href: '/catalog/chimney-caps/' },
  { label: 'Доборные элементы для кровли', href: '/catalog/roof-accessories/' },
  { label: 'Парапеты', href: '/catalog/roof-accessories/parapet-cap/' },
  { label: 'Весь каталог', href: '/catalog/' },
];

const serviceLinks = [
  { label: 'Монтаж дымоходов', href: '/services/chimney-installation/' },
  { label: 'Все услуги', href: '/services/' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container class="footer__inner">
    <div class="footer__brand">
      <Logo idPrefix="footer-logo" />
      <p class="footer__tagline">
        Производство изделий из листовой стали в Минске: дымоходы, колпаки, воздуховоды, доборные
        элементы кровли.
      </p>
    </div>

    <nav class="footer__nav" aria-label="Каталог продукции">
      <h2 class="footer__heading">Продукция</h2>
      <ul class="footer__list">
        {
          catalogLinks.map((link) => (
            <li>
              <a class="footer__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__nav" aria-label="Услуги">
      <h2 class="footer__heading">Услуги</h2>
      <ul class="footer__list">
        {
          serviceLinks.map((link) => (
            <li>
              <a class="footer__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Заголовок вне <address>: заголовки внутри него разметка не допускает */}
    <div class="footer__contacts">
      <h2 class="footer__heading">Контакты</h2>
      <address>
        <ul class="footer__list">
          <li>
            <a class="footer__link" href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>
          </li>
          <li>
            <a class="footer__link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </li>
          <li>{siteConfig.address.text}</li>
          <li>{formatOpeningHours(siteConfig.openingHours)}</li>
        </ul>
      </address>
    </div>
  </Container>

  <div class="footer__legal">
    <Container class="footer__legal-inner">
      <span>© {year} {siteConfig.name}</span>
      <span>{siteConfig.legalName} · УНП {siteConfig.unp}</span>
      <a class="footer__link" href="/privacy-policy/">Политика персональных данных</a>
    </Container>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .footer :global(.footer__inner) {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.8fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .footer__tagline {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 34ch;
  }

  .footer__heading {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .footer__list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  /* Курсив у <address> браузер ставит сам — наследование его не перебивает */
  .footer__contacts address {
    font-style: normal;
  }

  .footer__link {
    text-decoration: none;
    color: var(--color-text);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  .footer__legal {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer :global(.footer__legal-inner) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 767px) {
    .footer :global(.footer__inner) {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-block: var(--space-6);
    }

    /* Три блока в строку не влезают: ссылка сжимается до колонки из отдельных слов.
       На узком экране — столбик, каждая строка целиком */
    .footer :global(.footer__legal-inner) {
      flex-direction: column;
      align-items: start;
      gap: var(--space-2);
    }
  }

  /* Пальцем по футеру: строка текста даёт 21 px, соседние ссылки стоят в 8 px друг от друга —
     промах вместо перехода. Отдаём каждой строке списка 44 px и убираем зазор, чтобы футер
     не вырос вдвое. Растягивать нужно саму ссылку: цель — она, а не <li>.
     Условие по указателю, а не только по ширине: планшет в 768 px и тач-ноутбук — те же пальцы,
     а мышью по 21 px попадают точно (WCAG 2.5.8 такой шаг между целями пропускает). */
  @media (max-width: 767px), (pointer: coarse) {
    .footer__list {
      gap: 0;
    }

    .footer__list li {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .footer__link {
      display: flex;
      align-items: center;
      align-self: stretch;
      flex: 1;
    }

    /* Ссылка в нижней плашке — строчный элемент, min-height на нём не работает:
       переводим в inline-flex */
    .footer__legal .footer__link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      /* flex-цель не растягиваем на всю строку: клик мимо текста — не переход */
      align-self: start;
    }
  }
</style>
