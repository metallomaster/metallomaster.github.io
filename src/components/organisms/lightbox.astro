---
/*
 * Полноэкранный просмотр фото. Вставляется один раз на страницу;
 * виджеты лишь помечают ссылки <a data-lightbox-group="…" href="полноразмер">.
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Просмотр фото">
  <img class="lightbox__image" data-lightbox-image alt="" />

  <button
    class="lightbox__button lightbox__button--close"
    type="button"
    data-lightbox-close
    aria-label="Закрыть просмотр"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>

  <button
    class="lightbox__button lightbox__button--prev"
    type="button"
    data-lightbox-prev
    aria-label="Предыдущее фото"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>

  <button
    class="lightbox__button lightbox__button--next"
    type="button"
    data-lightbox-next
    aria-label="Следующее фото"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <span class="lightbox__counter" data-lightbox-counter aria-live="polite"></span>
</dialog>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    /* Тёмный оверлей одинаков в обеих темах */
    background: var(--color-overlay);
    color: var(--color-on-overlay);
    /* Горизонтальный свайп обрабатываем сами (pointer events) */
    touch-action: pan-y;
  }

  .lightbox::backdrop {
    background: none;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__image {
    max-width: calc(100% - var(--space-6));
    max-height: calc(100% - var(--space-9));
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }

  .lightbox__button {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-on-overlay) 12%, transparent);
    color: var(--color-on-overlay);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .lightbox__button:hover {
    background: color-mix(in srgb, var(--color-on-overlay) 24%, transparent);
  }

  .lightbox__button svg {
    width: 24px;
    height: 24px;
  }

  .lightbox__button--close {
    top: var(--space-4);
    right: var(--space-4);
  }

  .lightbox__button--prev {
    left: var(--space-3);
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__button--next {
    right: var(--space-3);
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__counter {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    translate: -50% 0;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-on-overlay) 12%, transparent);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { initLightbox } from '@/lib/lightbox';

  initLightbox(document.body);
</script>
