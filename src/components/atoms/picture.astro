---
/*
 * Адаптер оптимизации превью — единственный компонент, знающий про astro:assets
 * (полноразмер считает lib/content.ts). При миграции на другой фреймворк меняется только он.
 *
 * Отдаём AVIF и WebP: браузер берёт первый поддерживаемый, AVIF примерно на треть легче.
 */
import { Picture } from 'astro:assets';
import { PHOTO_THUMB_WIDTHS, fitWidths } from '@/lib/images';
import type { PictureSrc } from '@/lib/types';

interface Props {
  src: PictureSrc;
  alt: string;
  sizes?: string;
  /** Кандидат в LCP: грузится сразу и с высоким приоритетом. Ровно одна картинка на страницу. */
  priority?: boolean;
}

const {
  src,
  alt,
  sizes = '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, (max-width: 1439px) 33vw, 25vw',
  priority = false,
} = Astro.props;
---

{/* priority — готовый проп Astro: сам ставит loading, decoding и fetchpriority */}
<Picture
  src={src}
  alt={alt}
  widths={fitWidths(PHOTO_THUMB_WIDTHS, src.width)}
  sizes={sizes}
  priority={priority}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
/>
