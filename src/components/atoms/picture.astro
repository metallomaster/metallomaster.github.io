---
/*
 * Адаптер оптимизации изображений — один из двух компонентов, знающих про astro:assets
 * (второй — photo-link.astro). При миграции на другой фреймворк меняются только они.
 *
 * Отдаём AVIF и WebP: браузер берёт первый поддерживаемый, AVIF примерно на треть легче.
 */
import { Picture } from 'astro:assets';
import { PHOTO_THUMB_WIDTHS, fitWidths } from '@/lib/images';
import type { PictureSrc } from '@/lib/types';

interface Props {
  src: PictureSrc;
  alt: string;
  /** Ширины для srcset; по умолчанию под сетку карточек и галерей */
  widths?: readonly number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  widths = PHOTO_THUMB_WIDTHS,
  sizes = '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  widths={fitWidths(widths, src.width)}
  sizes={sizes}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  class={className}
/>
