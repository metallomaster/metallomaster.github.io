---
interface Props {
  /** Дополнительный класс снаружи */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['container', className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    /* В ландшафте чёлка заходит на страницу сбоку: отступ не меньше выреза */
    padding-inline-start: max(var(--container-pad), var(--safe-left));
    padding-inline-end: max(var(--container-pad), var(--safe-right));
  }
</style>
