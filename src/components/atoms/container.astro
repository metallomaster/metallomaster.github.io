---
interface Props {
  /** Дополнительный класс снаружи */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['container', className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }
</style>
